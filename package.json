{
  "name": "@bodanglin/verdict-node",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAI-compatible gateway adapter with execution-envelope validation for Express and Next.js",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrnicholasbcarter-code/verdict-node.git"
  },
  "homepage": "https://github.com/mrnicholasbcarter-code/verdict-node#readme",
  "bugs": {
    "url": "https://github.com/mrnicholasbcarter-code/verdict-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.md\" \"*.json\" \".github/workflows/*.yml\"",
    "pack:dry-run": "npm pack --dry-run",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "consumer:smoke": "npm run build && node scripts/consumer-smoke.mjs",
    "test:forwarder:junit": "JEST_JUNIT_OUTPUT_DIR=\"${JUNIT_OUTPUT_DIR:-.}\" JEST_JUNIT_OUTPUT_NAME=\"${JUNIT_OUTPUT_NAME:-forwarder_test_results.xml}\" node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/middleware/forwarder.test.ts --reporters=default --reporters=jest-junit"
  },
  "keywords": [
    "llm",
    "routing",
    "ai",
    "gateway-adapter",
    "safety",
    "middleware",
    "express",
    "openai-compatible",
    "zod"
  ],
  "dependencies": {
    "@bodanglin/verdict-contracts": "^0.2.0",
    "@types/express": "^5.0.6",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "express": ">=5.0.0 <6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "config": "^5.0.1",
    "express": "^5.2.1",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3"
  }
}
